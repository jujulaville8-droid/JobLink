# Public application URLs
NEXT_PUBLIC_SITE_URL=https://joblinkantigua.com
NEXT_PUBLIC_APP_URL=https://joblinkantigua.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: bypasses RLS. Server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email and inbound forwarding
RESEND_API_KEY=
# Support intake is disabled until this server-only value is explicitly set.
# Confirmed destination: support@joblinkantigua.com. Verify mailbox and bot access
# separately; no fallback or automatic acknowledgement to submitted addresses.
SUPPORT_RECIPIENT_EMAIL=
# Free ntfy signup alerts: production only. Topic acts as a bearer secret.
# Generate/enter it privately; never prefix with NEXT_PUBLIC_ or commit it.
# 32-64 random URL-safe characters. Alerts stay inactive unless all are set.
NTFY_SIGNUP_TOPIC=
NTFY_SIGNUP_ALERTS_ENABLED=false
# Activation time, UTC ISO string. Earlier accounts are excluded, no replay.
NTFY_SIGNUP_ALERTS_SINCE=
# Signing secret of the Resend webhook that targets
# /api/webhooks/resend-inbound. Not the same value as RESEND_API_KEY.
RESEND_WEBHOOK_SECRET=

# Scheduled jobs
# Sent by the scheduler as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Payments
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Signing secret of the Stripe webhook endpoint that targets
# /api/webhooks/stripe (starts with `whsec_`). Without it every delivery is
# rejected and no subscription is ever activated.
STRIPE_WEBHOOK_SECRET=

# Internal tools
# Shared secret for POST /api/admin/outreach (bulk employer outreach).
OUTREACH_SECRET=
# Shared secret for POST /api/send-outreach.
AGENT_WEBHOOK_SECRET=

# Employer-only screening: source implementation only, ALL rollout gates default OFF.
# See docs/employer-screening/README.md. No credential, price, or budget is supplied here.
EMPLOYER_SCREENING_ENABLED=false
EMPLOYER_SCREENING_SCHEMA_READY=false
EMPLOYER_SCREENING_CAPTURE_READY=false
EMPLOYER_SCREENING_PRIVACY_APPROVED=false
# Expanded professional-context boundary requires its own reviewed data-sharing approval.
EMPLOYER_SCREENING_CONTEXT_PRIVACY_APPROVED=false
EMPLOYER_SCREENING_WORKER_READY=false
EMPLOYER_SCREENING_DELIVERY_APPROVED=false
EMPLOYER_SCREENING_BUDGET_APPROVED=false
EMPLOYER_SCREENING_NOTICE_APPROVED=false
NEXT_PUBLIC_EMPLOYER_SCREENING_NOTICE_ENABLED=false
EMPLOYER_SCREENING_RUBRIC_APPROVAL_ENABLED=false
EMPLOYER_SCREENING_PAID_PROVIDER_ENABLED=false
EMPLOYER_SCREENING_BUDGET_CONFIG_ID=
EMPLOYER_OUTBOX_WORKER_ENABLED=false
EMPLOYER_OUTBOX_RECEIPTS_ENABLED=false
EMPLOYER_SCREENING_CAPTURE_CLEANUP_ENABLED=false
# OPENAI_API_KEY and EMPLOYER_DELIVERY_WEBHOOK_SECRET require separately authorized setup.
